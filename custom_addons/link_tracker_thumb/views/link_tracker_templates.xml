<odoo>
    <template id="link_tracker_preview">
        <head>
            <title t-esc="title"/>
            <meta property="og:title" t-att-content="title"/>
            <meta property="og:description" t-att-content="extended_description"/>
            <meta property="og:image" t-att-content="thumbnail_url"/>
            <meta property="og:url" t-att-content="url"/>
        </head>
        <body>
            <h1 t-esc="title"/>
            <p t-esc="extended_description"/>
            <img t-att-src="thumbnail_url" alt="Preview"/>
            <a t-att-href="url">Continue</a>
        </body>
    </template>
</odoo>
